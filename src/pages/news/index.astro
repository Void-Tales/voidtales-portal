---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { siteConfig } from '../../config/site.js';
import { newsSummary } from '../../utils/excerpt';
import { firstImage } from '../../utils/media';

const entries = (await getCollection('news')).sort(
	(a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

// Grouped by year with a jump list rather than paginated: this is 40 text-only
// entries. Paginating would hide half of a list that fits comfortably in one
// page and costs nothing to load.
const years: { year: number; entries: typeof entries }[] = [];
for (const entry of entries) {
	const year = entry.data.pubDatetime.getUTCFullYear();
	const last = years.at(-1);
	if (last && last.year === year) last.entries.push(entry);
	else years.push({ year, entries: [entry] });
}

const dateFormat = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

// The whole archive as an ordered list, so this reads as an archive and not as
// a page that happens to contain links.
const schema = {
	'@type': 'CollectionPage',
	'@id': `${siteConfig.url}/news/#collection`,
	name: 'News',
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: entries.map((entry, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: new URL(`/news/${entry.data.slug}/`, siteConfig.url).toString(),
			name: entry.data.title,
		})),
	},
};
---

<BaseLayout
	title="News"
	description="Announcements from the world of Void Tales — updates, events and patch notes."
	schema={schema}
>
	<PageHead image="news" title="News" narrow>
		<p class="section-lead">
			Everything announced for Void Tales, newest first. The day-to-day progress lives in the{' '}
			<a href="/devlog/">devlog</a>.
		</p>
	</PageHead>

	<section class="section section--follow">
		<div class="shell shell-narrow">
			<nav class="month-nav" aria-label="News archive">
				{years.map(({ year }) => (
					<a href={`#${year}`}>{year}</a>
				))}
			</nav>

			{years.map(({ year, entries: yearEntries }) => (
				<>
					<h2 class="month-heading" id={String(year)}>
						{year}
					</h2>
					<ul class="entry-list">
						{yearEntries.map((entry) => {
							const image = firstImage(entry.body);
							return (
								<li>
									<article class:list={['entry-card', image && 'entry-card--media']}>
										{image && (
											<img
												src={image.src}
												srcset={image.srcset}
												sizes="(width >= 48rem) 14rem, calc(100vw - 2rem)"
												alt=""
												width={image.width}
												height={image.height}
												loading="lazy"
												decoding="async"
											/>
										)}
										<div class="entry-card-text">
											<time datetime={entry.data.pubDatetime.toISOString()}>
												{dateFormat.format(entry.data.pubDatetime)}
											</time>
											<h3>
												<a href={`/news/${entry.data.slug}/`}>{entry.data.title}</a>
											</h3>
											<p>{newsSummary(entry.data.description, entry.body ?? '')}</p>
										</div>
									</article>
								</li>
							);
						})}
					</ul>
				</>
			))}
		</div>
	</section>
</BaseLayout>
