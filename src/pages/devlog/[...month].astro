---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { siteConfig } from '../../config/site.js';
import { berlinDay, berlinMonth } from '../../utils/berlin.js';
import { devlogAnchor } from '../../utils/devlog';

// One page per month rather than per N entries: a month URL still points at the
// same entries a year from now, while /devlog/2 shifts by one every time
// something is posted. `/devlog` itself serves the newest month.
export async function getStaticPaths() {
	const all = (await getCollection('devlog')).sort(
		(a, b) => a.data.date.valueOf() - b.data.date.valueOf()
	);

	const months = [...new Set(all.map((e) => berlinMonth(e.data.date)))].reverse();

	const page = (month: string) => ({
		month,
		months,
		entries: all.filter((e) => berlinMonth(e.data.date) === month),
	});

	return [
		{ params: { month: undefined }, props: page(months[0]) },
		...months.map((month) => ({ params: { month }, props: page(month) })),
	];
}

const { month, months, entries } = Astro.props;

// A day of messages by the same person is one thought, so it renders as one
// block with the messages as consecutive paragraphs. Grouping lives here and
// not in the import, which keeps the n8n side at "write one file".
// The anchor is day plus author: two people posting on the same day gave two
// blocks with the same id. Counted in time order, so a new post never renumbers
// an older block.
type Group = { id: string; day: string; author?: string; date: Date; entries: typeof entries };
const groups: Group[] = [];
const seen = new Map<string, number>();
for (const entry of entries) {
	const day = berlinDay(entry.data.date);
	const last = groups.at(-1);
	if (last && last.day === day && last.author === entry.data.author) {
		last.entries.push(entry);
	} else {
		const base = devlogAnchor(day, entry.data.author);
		const n = (seen.get(base) ?? 0) + 1;
		seen.set(base, n);
		const id = n === 1 ? base : `${base}-${n}`;
		groups.push({ id, day, author: entry.data.author, date: entry.data.date, entries: [entry] });
	}
}
groups.reverse();

const rendered = await Promise.all(
	groups.map(async (group) => ({
		...group,
		parts: await Promise.all(
			group.entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
		),
	}))
);

const monthFormat = new Intl.DateTimeFormat('en-GB', {
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
const dayFormat = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'Europe/Berlin',
});

const label = (m: string) => monthFormat.format(new Date(`${m}-01T00:00:00Z`));
// Trailing slash: that is where nginx serves the directory; without it every
// link and the canonical went through a 301.
const href = (m: string) => (m === months[0] ? '/devlog/' : `/devlog/${m}/`);
const current = label(month);

// Month jump list, one row per year: 14 full month names took six rows on a phone
// before the first entry.
const shortMonth = new Intl.DateTimeFormat('en-GB', { month: 'short', timeZone: 'UTC' });
const years = [...new Set(months.map((m) => m.slice(0, 4)))].map((year) => ({
	year,
	months: months.filter((m) => m.startsWith(year)),
}));
const at = months.indexOf(month);
const newer = months[at - 1];
const older = months[at + 1];

// /devlog und /devlog/<neuester-monat> liefern denselben Inhalt. Fuer Google
// ist das Duplicate Content, und in der Pagefind-Suche standen beide Seiten
// mit identischem Textausschnitt untereinander. Die Monats-URL ist die
// bleibende, also zeigt der Alias per canonical dorthin und wird nicht
// mitindexiert. Der Alias bleibt trotzdem: er ist der Navigationslink.
const isAlias = Astro.params.month === undefined;

// The day blocks are the real items here, and each one already carries an
// anchor — so the month page is a CollectionPage of dated postings, not one
// article. Without this a crawler sees one long page and no dates at all.
const schema = {
	'@type': 'CollectionPage',
	'@id': `${new URL(href(month), siteConfig.url).toString()}#collection`,
	name: `Devlog — ${current}`,
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	hasPart: rendered.map((group) => ({
		'@type': 'BlogPosting',
		headline: `Devlog — ${dayFormat.format(group.date)}`,
		datePublished: group.date.toISOString(),
		...(group.author ? { author: { '@type': 'Person', name: group.author } } : {}),
		url: new URL(`${href(month)}#${group.id}`, siteConfig.url).toString(),
	})),
};
---

<BaseLayout
	title={`Devlog — ${current}`}
	description={`What was built on Void Tales in ${current}, day by day.`}
	ogImage={`/images/og/devlog-${month}.webp`}
	schema={schema}
	canonical={`/devlog/${month}/`}
>
	<PageHead image="devlog" title="Devlog" narrow>
		<p class="section-lead">
			Day-by-day progress on Void Tales. Bigger announcements land in the <a href="/news/">news</a>.
		</p>
	</PageHead>

	<section
		class="section section--follow"
		data-pagefind-ignore={isAlias ? 'all' : undefined}
		data-pagefind-meta={isAlias ? undefined : `title:Devlog — ${current}`}
	>
		<div class="shell shell-narrow">
			<nav class="year-nav" data-pagefind-ignore aria-label="Devlog archive">
				{years.map(({ year, months: inYear }) => (
					<div class="year-nav-row">
						<span class="year-nav-year">{year}</span>
						{inYear.map((m) => (
							<a
								href={href(m)}
								aria-current={m === month ? 'page' : undefined}
								aria-label={label(m)}
							>
								{shortMonth.format(new Date(`${m}-01T00:00:00Z`))}
							</a>
						))}
					</div>
				))}
			</nav>

			<h2 class="month-heading">{current}</h2>

			{rendered.map((group) => (
				<article class="devlog-day" id={group.id}>
					<h3>
						<a href={`${href(month)}#${group.id}`}>
							<time datetime={group.day}>{dayFormat.format(group.date)}</time>
						</a>
					</h3>
					{group.author && <p class="devlog-author">{group.author}</p>}
					{group.parts.map(({ Content }) => (
						<div class="prose">
							<Content />
						</div>
					))}
				</article>
			))}

			<nav class="post-nav" data-pagefind-ignore aria-label="More of the devlog">
				{older && (
					<a href={href(older)}>
						<span>Older</span>
						{label(older)}
					</a>
				)}
				{newer && (
					<a class="post-nav-newer" href={href(newer)}>
						<span>Newer</span>
						{label(newer)}
					</a>
				)}
			</nav>
		</div>
	</section>
</BaseLayout>
