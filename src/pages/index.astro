---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollCue from '../components/ScrollCue.astro';
import ServerStatus from '../components/ServerStatus.astro';
import { siteConfig, storySections, galleryImages } from '../config/site.js';
import { socialLinks, isExternal } from '../config/navigation.js';
import community from '../generated/community.json';
import youtube from '../generated/youtube.json';
import { berlinDay, berlinMonth } from '../utils/berlin.js';
import { devlogAnchor } from '../utils/devlog';
import { excerpt, newsSummary } from '../utils/excerpt';
import { firstImage } from '../utils/media';

const { hero, gallery, film, map, latest, join, social, modrinthUrl, galleryUrl } = siteConfig;

// `titleAccent` is the trailing word of `hero.title` that carries the accent colour.
const accentAt = hero.title.lastIndexOf(hero.titleAccent);
const heroLead = hero.title.slice(0, accentAt).trim();

// Scroll cues form a chain: hero -> realm 1 -> realm 2 -> gallery -> film -> map ->
// latest -> join. Each one is a real anchor, so the label names where it jumps to.
const anchorOf = (i: number) => (i < storySections.length ? `realm-${i + 1}` : 'gallery');
const titleOf = (i: number) => (i < storySections.length ? storySections[i].title : gallery.title);

// Each 1200w image has a smaller sibling `<name>-<w>.webp` next to it in public/images.
const srcsetOf = (src: string, w: number) =>
	`${src.replace(/\.webp$/, `-${w}.webp`)} ${w}w, ${src} 1200w`;

// The strip: real shots from the gallery, chosen at build time (scripts/community.mjs).
// A failed lookup leaves an empty list and the fixed images take over.
type Tile = { src: string; srcset: string; alt: string; author?: string; url?: string };
const tiles: Tile[] = community.length
	? community.map((c) => ({
			src: c.src,
			srcset: `${c.small} 800w, ${c.src} 1600w`,
			alt: c.alt,
			author: c.author,
			url: c.url,
		}))
	: galleryImages.map((g) => ({ src: g.src, srcset: srcsetOf(g.src, 600), alt: g.alt }));

// Films: click to load, see src/scripts/embeds.ts. The first one runs large.
const titles = youtube as Record<string, { title: string }>;
const videos = film.videos.map((v) => {
	const thumb = 'thumb' in v && v.thumb ? v.thumb : `/images/yt/${v.id}.webp`;
	return {
		...v,
		thumb,
		small: thumb.replace(/\.webp$/, '-640.webp'),
		title: titles[v.id]?.title ?? v.label,
	};
});

// What happened lately, from the same collections as /news and /devlog.
const news = (await getCollection('news')).sort(
	(a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);
const newest = news[0];
const newestImage = firstImage(newest?.body);
const dateFormat = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'Europe/Berlin',
});

// One line per day and author, as the devlog groups them. Posts that are only a
// picture have nothing to quote and are passed over.
const devlogDays = new Map<string, { date: Date; href: string; text: string }>();
for (const entry of (await getCollection('devlog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)) {
	const anchor = devlogAnchor(berlinDay(entry.data.date), entry.data.author);
	const text = excerpt(entry.body ?? '', 110);
	if (devlogDays.has(anchor) || !text) continue;
	devlogDays.set(anchor, {
		date: entry.data.date,
		href: `/devlog/${berlinMonth(entry.data.date)}/#${anchor}`,
		text,
	});
	if (devlogDays.size === 3) break;
}
---

<BaseLayout>
	{/* 1 - Hero: full-bleed screenshot, copy anchored to the bottom edge */}
	<section class="hero">
		<div class="hero-bg"></div>
		<div class="hero-scrim"></div>
		{/* Halloween only (global.css, html.halloween): pixel bats, a jack o'lantern block, fog */}
		<div class="spuk" aria-hidden="true">
			<i class="fm"></i>
			<i class="fm"></i>
			<i class="fm"></i>
			<span class="kb"></span>
		</div>

		<div class="shell hero-body">
			<h1 class="hero-title" style="--i: 0">
				{heroLead} <span class="accent">{hero.titleAccent}</span>
			</h1>
			<p class="hero-subtitle" style="--i: 1">
				{hero.subtitle}
			</p>

			<div class="hero-actions" style="--i: 2">
				<a href={modrinthUrl} target="_blank" rel="noopener" class="btn btn-primary">
					{hero.ctaLabel}
				</a>
				<ServerStatus variant="inline" />

				<ScrollCue to={anchorOf(0)} label={titleOf(0)} />
			</div>

			{newest && (
				<a class="hero-latest" style="--i: 3" href={`/news/${newest.data.slug}/`}>
					Latest news: {newest.data.title}
				</a>
			)}
		</div>
	</section>

	{/* 2 - The realms, as a sticky stack: panel 2 slides over panel 1.
	    The wrapper is load-bearing: it is the containing block that lets the
	    panels unstick again, otherwise they stay pinned under every section
	    that follows. */}
	<div class="story-stack">
		{storySections.map((section, i) => (
			<section class="story-panel" id={`realm-${i + 1}`}>
				<div class="shell story-grid">
					<div class:list={['story-copy', i % 2 === 1 && 'lg:order-2']}>
						<h2>{section.title}</h2>
						<p class="section-lead">{section.body}</p>
						<ul class="story-points">
							{section.points.map((point) => (
								<li>{point}</li>
							))}
						</ul>
					</div>

					<figure
						class:list={['story-figure', i % 2 === 1 && ['story-figure--left', 'lg:order-1']]}
					>
						<img
							src={section.image}
							srcset={srcsetOf(section.image, 800)}
							sizes="(width >= 1024px) 50vw, 100vw"
							alt={section.imageAlt}
							width="1200"
							height="675"
							loading="lazy"
							decoding="async"
						/>
					</figure>
				</div>

				<ScrollCue to={anchorOf(i + 1)} label={titleOf(i + 1)} panel />
			</section>
		))}
	</div>

	{/* 3 - Gallery: the track pans sideways with the scroll where that is
	    supported, and stays a manual scroll-snap strip everywhere else. */}
	<section class="section pan border-t border-line" id="gallery">
		<div class="pan-sticky">
			<div class="shell rise">
				<h2>{gallery.title}</h2>
				<p class="section-lead">{gallery.body}</p>
			</div>

			<div
				class="pan-viewport"
				tabindex="0"
				role="region"
				aria-label="Screenshots from the Void Tales realms"
			>
				<div class="pan-track">
					{tiles.map((tile) =>
						tile.url ? (
							<a class="pan-tile" href={tile.url} aria-label={`${tile.alt}, open in the gallery`}>
								<img
									src={tile.src}
									srcset={tile.srcset}
									sizes="(width >= 48rem) 42rem, 76vw"
									alt=""
									width="1600"
									height="900"
									loading="lazy"
									decoding="async"
								/>
								<span class="pan-credit">{tile.author}</span>
							</a>
						) : (
							<div class="pan-tile">
								<img
									src={tile.src}
									srcset={tile.srcset}
									sizes="(width >= 48rem) 42rem, 76vw"
									alt={tile.alt}
									width="1200"
									height="675"
									loading="lazy"
									decoding="async"
								/>
							</div>
						)
					)}
					<a href={galleryUrl} class="pan-tile pan-more">
						<strong>{gallery.moreLabel}</strong>
						<span>{gallery.moreHint}</span>
					</a>
				</div>
			</div>

			<ScrollCue to="trailer" label={film.title} panel />
		</div>
	</section>

	{/* 4 - Film: the Reboot large, the current trailer beside it */}
	<section class="section border-t border-line" id="trailer">
		<div class="shell rise">
			<h2>{film.title}</h2>
			<p class="section-lead mb-10">{film.lead}</p>

			<div class="film-grid">
				{videos.map((video) => (
					<figure class="film">
						<div class="trailer-frame">
							<a
								class="trailer-play"
								href={`https://www.youtube.com/watch?v=${video.id}`}
								data-embed={`https://www.youtube-nocookie.com/embed/${video.id}`}
								aria-label={`Play ${video.title} (loads YouTube)`}
							>
								<img
									src={video.thumb}
									srcset={`${video.small} 640w, ${video.thumb} 1280w`}
									sizes="(width >= 64rem) 45rem, 100vw"
									alt=""
									width="1280"
									height="720"
									loading="lazy"
									decoding="async"
								/>
								<svg viewBox="0 0 68 48" aria-hidden="true">
									<path
										class="trailer-play-bg"
										d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"
									/>
									<path d="M27 34V14l18 10z" fill="#fff" />
								</svg>
							</a>
						</div>
						<figcaption>{video.label}</figcaption>
					</figure>
				))}
			</div>

			<div class="mt-12 flex justify-end">
				<ScrollCue to="map" label={map.title} />
			</div>
		</div>
	</section>

	{/* 5 - World map: the islands float on the page, the real map loads on a click */}
	<section class="section border-t border-line" id="map">
		<div class="shell map-grid">
			<div class="map-copy">
				<h2>{map.title}</h2>
				<p class="section-lead">{map.body}</p>
				<a class="btn btn-primary mt-8" href={map.url} target="_blank" rel="noopener">
					{map.cta}
				</a>
			</div>
			<a
				class="map-figure"
				href={map.url}
				target="_blank"
				rel="noopener"
				data-map-embed
				aria-label={`${map.cta}: ${map.imageAlt}`}
			>
				<img
					src={map.image}
					srcset={`${map.image.replace(/\.webp$/, '-900.webp')} 900w, ${map.image} 1800w`}
					sizes="(width >= 64rem) 60vw, 100vw"
					alt=""
					width="1800"
					height="1203"
					loading="lazy"
					decoding="async"
				/>
			</a>
		</div>
		<div class="shell mt-8 flex justify-end">
			<ScrollCue to="latest" label={latest.title} />
		</div>
	</section>

	{/* 6 - Latest: the newest post and the last days of the devlog */}
	{newest && (
		<section class="section border-t border-line" id="latest">
			<div class="shell">
				<h2 class="rise">{latest.title}</h2>
				<div class="latest-grid mt-10 rise">
					<article class="latest-news">
						{newestImage && (
							<img
								src={newestImage.src}
								srcset={newestImage.srcset}
								sizes="(width >= 64rem) 42rem, 100vw"
								alt=""
								width={newestImage.width}
								height={newestImage.height}
								loading="lazy"
								decoding="async"
							/>
						)}
						<div class="latest-news-text">
							<time datetime={newest.data.pubDatetime.toISOString()}>
								{dateFormat.format(newest.data.pubDatetime)}
							</time>
							<h3>
								<a href={`/news/${newest.data.slug}/`}>{newest.data.title}</a>
							</h3>
							<p>{newsSummary(newest.data.description, newest.body ?? '')}</p>
						</div>
					</article>

					<div class="latest-side">
						<h3>{latest.devlogTitle}</h3>
						<ul>
							{[...devlogDays.values()].map((day) => (
								<li>
									<a href={day.href}>
										<time datetime={day.date.toISOString()}>{dateFormat.format(day.date)}</time>
										<span>{day.text}</span>
									</a>
								</li>
							))}
						</ul>
						<p class="latest-links">
							<a href="/news/">{latest.allNews}</a>
							<a href="/devlog/">{latest.allDevlog}</a>
						</p>
					</div>
				</div>
				<div class="mt-12 flex justify-end">
					<ScrollCue to="join" label={join.title} />
				</div>
			</div>
		</section>
	)}

	{/* 7 - Join: the three steps, the live server card, and the social links */}
	<section class="section border-t border-line" id="join">
		<div class="shell">
			<h2 class="rise">{join.title}</h2>

			<div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
				<ol class="steps rise">
					{join.steps.map((step, i) => (
						<li class="step" data-step={i + 1}>
							<h3>{step.title}</h3>
							<p>{step.body}</p>
							{i === 0 && (
								<a href={modrinthUrl} target="_blank" rel="noopener" class="btn btn-modrinth mt-4">
									{hero.ctaLabel}
									<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M12.252.004a11.78 11.768 0 0 0-8.92 3.73a11 11 0 0 0-2.17 3.11a11.37 11.359 0 0 0-1.16 5.169c0 1.42.17 2.5.6 3.77c.24.759.77 1.899 1.17 2.529a12.3 12.298 0 0 0 8.85 5.639c.44.05 2.54.07 2.76.02c.2-.04.22.1-.26-1.7l-.36-1.37l-1.01-.06a8.5 8.489 0 0 1-5.18-1.8a5.3 5.3 0 0 1-1.3-1.26c0-.05.34-.28.74-.5a37.572 37.545 0 0 1 2.88-1.629c.03 0 .5.45 1.06.98l1 .97l2.07-.43l2.06-.43l1.47-1.47c.8-.8 1.48-1.5 1.48-1.52c0-.09-.42-1.63-.46-1.7c-.04-.06-.2-.03-1.02.18c-.53.13-1.2.3-1.45.4l-.48.15l-.53.53l-.53.53l-.93.1l-.93.07l-.52-.5a2.7 2.7 0 0 1-.96-1.7l-.13-.6l.43-.57c.68-.9.68-.9 1.46-1.1c.4-.1.65-.2.83-.33c.13-.099.65-.579 1.14-1.069l.9-.9l-.7-.7l-.7-.7l-1.95.54c-1.07.3-1.96.53-1.97.53c-.03 0-2.23 2.48-2.63 2.97l-.29.35l.28 1.03c.16.56.3 1.16.31 1.34l.03.3l-.34.23c-.37.23-2.22 1.3-2.84 1.63c-.36.2-.37.2-.44.1c-.08-.1-.23-.6-.32-1.03c-.18-.86-.17-2.75.02-3.73a8.84 8.84 0 0 1 7.9-6.93c.43-.03.77-.08.78-.1c.06-.17.5-2.999.47-3.039c-.01-.02-.1-.02-.2-.03Zm3.68.67c-.2 0-.3.1-.37.38c-.06.23-.46 2.42-.46 2.52c0 .04.1.11.22.16a8.51 8.499 0 0 1 2.99 2a8.38 8.379 0 0 1 2.16 3.449a6.9 6.9 0 0 1 .4 2.8c0 1.07 0 1.27-.1 1.73a9.4 9.4 0 0 1-1.76 3.769c-.32.4-.98 1.06-1.37 1.38c-.38.32-1.54 1.1-1.7 1.14c-.1.03-.1.06-.07.26c.03.18.64 2.56.7 2.78l.06.06a12.07 12.058 0 0 0 7.27-9.4c.13-.77.13-2.58 0-3.4a11.96 11.948 0 0 0-5.73-8.578c-.7-.42-2.05-1.06-2.25-1.06Z" />
									</svg>
								</a>
							)}
						</li>
					))}
				</ol>

				<ServerStatus variant="full" />
			</div>

			<div class="mt-16 border-t border-line pt-10">
				<h3>{social.title}</h3>
				<div class="mt-5 flex flex-wrap gap-3">
					{socialLinks.map((link) => (
						<a
							href={link.href}
							target={isExternal(link.href) ? '_blank' : undefined}
							rel={isExternal(link.href) ? 'noopener' : undefined}
							class="btn"
						>
							{link.label}
						</a>
					))}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	// A sticky panel taller than the screen pins its top and the next panel slides over
	// its last lines before anybody could read them (112 px of text on a 360x640 phone,
	// more with the URL bar out). `--panel-h` lets the CSS pin such a panel by its bottom
	// edge instead, so all of it passes by first. Not motion, so it runs for everybody.
	const panels = new ResizeObserver((entries) => {
		for (const entry of entries) {
			(entry.target as HTMLElement).style.setProperty(
				'--panel-h',
				`${(entry.target as HTMLElement).offsetHeight}px`
			);
		}
	});
	for (const panel of document.querySelectorAll('.story-panel')) panels.observe(panel);
</script>

<script>
	// Scroll-linked motion. The gallery pan runs on the compositor where the browser has
	// view timelines (Chromium, Safari 26): a Pixel draws at 120 Hz while its main thread
	// ticks at 60 and misses frames on a flick, so a track moved from script stepped along
	// at half the rate, up to 254 px at once. Firefox gets the same motion from a passive
	// scroll listener, attached only while the section is on screen, one rAF per frame.
	//
	// If you ever move this back to CSS: `animation-timeline` must not share a
	// declaration block with the `animation` shorthand. The CSS minifier folds
	// the two together, and a shorthand carrying a timeline is invalid, so the
	// whole declaration is dropped without warning.
	//
	// Without JS every element stays visible, the hero image sits still and the
	// gallery is a manual scroll-snap strip. That is the designed fallback.
	const reduced = matchMedia('(prefers-reduced-motion: reduce)');

	/** Runs `tick` at most once per frame on scroll, but only while `el` intersects the viewport. */
	function whileVisible(el: Element, tick: () => void) {
		let visible = false;
		let pending = 0;
		const onScroll = () => {
			pending ||= requestAnimationFrame(() => {
				pending = 0;
				tick();
			});
		};
		new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting === visible) return;
			visible = entry.isIntersecting;
			if (visible) {
				addEventListener('scroll', onScroll, { passive: true });
				onScroll();
			} else removeEventListener('scroll', onScroll);
		}).observe(el);
	}

	const clamp = (n: number) => Math.min(1, Math.max(0, n));

	if (!reduced.matches) {
		// Entrances: the observer fires the animation once, so nothing is ever
		// left sitting at opacity 0 waiting for a trigger that may not come.
		const entrances = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					el.style.removeProperty('opacity');
					el.animate(
						{ opacity: [0, 1], transform: ['translateY(1.5rem)', 'none'] },
						{ duration: 700, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' }
					);
					entrances.unobserve(el);
				}
			},
			{ threshold: 0.15 }
		);
		for (const el of document.querySelectorAll<HTMLElement>('.rise')) {
			// Already on screen when the script runs: it has already painted,
			// an entrance here would be exactly the flash we're removing.
			if (el.getBoundingClientRect().top <= innerHeight) continue;
			el.style.opacity = '0';
			entrances.observe(el);
		}

		// Hero: the background drifts as the hero scrolls away.
		const hero = document.querySelector<HTMLElement>('.hero');
		const heroBg = document.querySelector<HTMLElement>('.hero-bg');
		if (hero && heroBg) {
			whileVisible(hero, () => {
				const p = clamp(-hero.getBoundingClientRect().top / window.innerHeight);
				heroBg.style.transform = `scale(1.14) translateY(${p * 6}%)`;
			});
		}

		// Gallery: pin the section and pan the track sideways across the extra
		// height. On every width - a phone gets the same effect, and manual
		// swiping is off in pan mode anyway (`.pan-viewport { overflow: visible }`).
		const pan = document.querySelector<HTMLElement>('.pan');
		const track = pan?.querySelector<HTMLElement>('.pan-track');
		const sticky = pan?.querySelector<HTMLElement>('.pan-sticky');

		if (pan && track && sticky) {
			// The inner row, not <header>: it is the `--header-h` line and never
			// grows, while the header itself gets taller with the mobile menu open.
			const headerH = document.querySelector('.site-header-inner')?.clientHeight ?? 0;
			let travel = 0;
			// The strip moves faster than the page scrolls. At 1:1 the larger tiles held the
			// same heading on screen for five screens.
			const SPEED = 1.8;
			const scrollLength = () => travel / SPEED;
			// Not in TypeScript's DOM types yet.
			const ViewTimelineApi = (window as any).ViewTimeline;
			let onCompositor: Animation | undefined;

			const measure = () => {
				onCompositor?.cancel();
				pan.classList.remove('is-panning');
				pan.style.removeProperty('height');
				track.style.removeProperty('transform');
				travel = 0;

				pan.classList.add('is-panning');

				// Measured rather than recomputed from the CSS, so the geometry has
				// exactly one source of truth: track content plus both insets, minus
				// what already fits on screen.
				const first = track.firstElementChild?.getBoundingClientRect().left ?? 0;
				const last = track.lastElementChild?.getBoundingClientRect().right ?? 0;
				const inset = parseFloat(getComputedStyle(track).paddingInlineStart);
				// clientWidth, not innerWidth: the track ends at the page edge, and
				// innerWidth counts the scrollbar gutter on top.
				travel = Math.max(0, last - first + 2 * inset - document.documentElement.clientWidth);

				if (travel === 0) {
					pan.classList.remove('is-panning');
					return;
				}
				// The pinned child's real height, not `window.innerHeight`: the CSS
				// sizes it in `svh`, and on mobile `innerHeight` follows the URL bar.
				// Two sources would disagree by exactly the URL bar's height.
				pan.style.height = `${sticky.offsetHeight + scrollLength()}px`;

				// `exit-crossing` counts from the section's top edge, so the range stays put
				// when the URL bar changes the screen height (`contain` and `cover` would not).
				if (ViewTimelineApi) {
					onCompositor = track.animate({ transform: ['none', `translateX(${-travel}px)`] }, {
						timeline: new ViewTimelineApi({ subject: pan, axis: 'block' }),
						rangeStart: { rangeName: 'exit-crossing', offset: CSS.px(-headerH) },
						rangeEnd: { rangeName: 'exit-crossing', offset: CSS.px(scrollLength() - headerH) },
						easing: 'linear',
						fill: 'both',
					} as KeyframeAnimationOptions);
				}
			};

			measure();

			// Lazy loading can't see past the clip on `.pan-sticky`: tiles off to the side only
			// loaded as they slid into view, empty on a flick. So the whole strip comes in
			// together once the section is close.
			const near = new IntersectionObserver(
				([entry]) => {
					if (!entry.isIntersecting) return;
					near.disconnect();
					for (const img of track.querySelectorAll('img')) img.loading = 'eager';
				},
				{ rootMargin: '150% 0px' }
			);
			near.observe(pan);

			if (!ViewTimelineApi) {
				whileVisible(pan, () => {
					if (travel === 0) return;
					const p = clamp((headerH - pan.getBoundingClientRect().top) / scrollLength());
					track.style.transform = `translateX(${-p * travel}px)`;
				});
			}

			// Keyboard in pan mode: the strip doesn't scroll itself any more, so the
			// arrows scroll the page by one tile, which moves the track by as much.
			const viewport = pan.querySelector<HTMLElement>('.pan-viewport');
			viewport?.addEventListener('keydown', (e) => {
				if (travel === 0 || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
				e.preventDefault();
				const tile = track.firstElementChild?.getBoundingClientRect().width ?? 0;
				const step = tile + parseFloat(getComputedStyle(track).columnGap);
				window.scrollBy(0, (e.key === 'ArrowRight' ? step : -step) / SPEED);
			});

			// Tabbing to the "more" tile while it sits off screen: scroll the page to
			// the point where the track shows it, instead of leaving focus invisible.
			pan.addEventListener('focusin', (e) => {
				const tile = (e.target as Element).closest<HTMLElement>('.pan-tile');
				if (travel === 0 || !tile) return;
				const inset = parseFloat(getComputedStyle(track).paddingInlineStart);
				const box = tile.getBoundingClientRect();
				const width = document.documentElement.clientWidth;
				if (box.left >= 0 && box.right <= width) return;
				// The track moves SPEED pixels per pixel the page scrolls.
				window.scrollBy(0, (box.left < 0 ? box.left - inset : box.right + inset - width) / SPEED);
			});

			// Resize changes the tile width and therefore the travel. Width only:
			// mobile Chrome fires `resize` on every URL bar toggle, and re-measuring
			// tears `is-panning` down and back up in the middle of a scroll.
			let lastW = window.innerWidth;
			let pending = 0;
			window.addEventListener('resize', () => {
				if (window.innerWidth === lastW) return;
				lastW = window.innerWidth;
				cancelAnimationFrame(pending);
				pending = requestAnimationFrame(measure);
			});
		}
	}
</script>
