---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemCard from '../../components/ItemCard.astro';
import PageHead from '../../components/PageHead.astro';
import { siteConfig } from '../../config/site.js';
import { CATEGORIES, generated, items, regionLabel, regionShown } from '../../utils/items.ts';
import { plainText } from '../../utils/minimessage.ts';

const dateFormat = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

const sections = CATEGORIES.map((c) => ({
	...c,
	items: items.filter((i) => i.category === c.key),
})).filter((s) => s.items.length);
// Items without a place of their own (General, the Gemstones folder) are reached
// through the type row; as regions they would only say the same thing twice.
const regions = [...new Set(items.map(regionShown).filter((r): r is string => Boolean(r)))].sort();

const filters = [
	{ key: 'category', label: 'Type', values: sections.map((s) => [s.key, s.label]) },
	{ key: 'region', label: 'Region', values: regions.map((r) => [r, r]) },
	{
		key: 'status',
		label: 'Status',
		values: [
			['live', 'In game'],
			['experimental', 'Experimental'],
		],
	},
];

// "Changes in testing" is a live item: it filters with the live ones.
const statusKey = (s: string) => (s === 'experimental' ? 'experimental' : 'live');

const schema = {
	'@type': 'CollectionPage',
	'@id': `${siteConfig.url}/items#collection`,
	name: 'Items',
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: items.length,
		itemListElement: items.map((item, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: new URL(`/items/${item.id}/`, siteConfig.url).toString(),
			name: plainText(item.name),
		})),
	},
};
---

<BaseLayout
	title="Items"
	description="Every weapon, armour piece, gem and consumable in Void Tales, straight from the game files — including what is being tested right now."
	schema={schema}
>
	<PageHead image="items" title="Items">
		<p class="section-lead">
			Weapons, armour, gems and consumables, straight from the game files. Items marked
			<span class="item-badge">Experimental</span> are on the test server and can still change.
		</p>
	</PageHead>

	<section class="section section--follow">
		<div class="shell">
			<p class="item-stand">
				Updated <time datetime={generated.toISOString()}>{dateFormat.format(generated)}</time>
				{' · '}
				{items.length} items
			</p>

			<div class="item-filters" data-item-filters>
				<input
					type="search"
					class="item-search"
					placeholder="Search items"
					aria-label="Search items by name"
					data-item-search
				/>
				{filters.map((f) => (
					<div class="item-filter-row" role="group" aria-label={f.label}>
						<span class="item-filter-label">{f.label}</span>
						{f.values.map(([value, label]) => (
							<button
								type="button"
								class="chip"
								data-key={f.key}
								data-value={value}
								aria-pressed="false"
							>
								{label}
							</button>
						))}
					</div>
				))}
				<p class="item-count" aria-live="polite" data-item-count></p>
			</div>

			{sections.map((section) => (
				<section class="item-section" data-item-section>
					<h2 class="month-heading" id={section.key}>
						{section.label}
					</h2>
					<ul class="item-grid">
						{section.items.map((item) => (
							<li
								data-item
								data-category={item.category}
								data-region={regionLabel(item)}
								data-status={statusKey(item.status)}
								data-name={[plainText(item.name), ...item.type, regionLabel(item), section.label]
									.join(' ')
									.toLowerCase()}
							>
								<ItemCard item={item} />
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</section>
</BaseLayout>

<script>
	// Search plus filter chips: within one row the chips are OR, across rows AND, and the
	// search narrows on top. The state lives in the address (?q=&category=&region=&status=),
	// so a filtered view can be linked. Without JS the bar stays hidden (global.css,
	// html:not(.js)) and every item is simply listed.
	const bar = document.querySelector<HTMLElement>('[data-item-filters]');
	if (bar) {
		const chips = [...bar.querySelectorAll<HTMLButtonElement>('.chip')];
		const cards = [...document.querySelectorAll<HTMLElement>('[data-item]')];
		const count = bar.querySelector<HTMLElement>('[data-item-count]')!;
		const search = bar.querySelector<HTMLInputElement>('[data-item-search]')!;

		const apply = () => {
			const active: Record<string, Set<string>> = {};
			for (const c of chips) {
				if (c.getAttribute('aria-pressed') !== 'true') continue;
				(active[c.dataset.key!] ??= new Set()).add(c.dataset.value!);
			}
			const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
			let shown = 0;
			for (const card of cards) {
				const ok =
					Object.entries(active).every(([k, set]) => set.has(card.dataset[k]!)) &&
					words.every((w) => card.dataset.name!.includes(w));
				card.hidden = !ok;
				if (ok) shown++;
			}
			for (const s of document.querySelectorAll<HTMLElement>('[data-item-section]')) {
				s.hidden = !s.querySelector('[data-item]:not([hidden])');
			}
			count.textContent = shown === cards.length ? '' : `Showing ${shown} of ${cards.length} items`;

			const params = new URLSearchParams();
			if (search.value.trim()) params.set('q', search.value.trim());
			for (const [k, set] of Object.entries(active)) params.set(k, [...set].join(','));
			const query = params.toString();
			history.replaceState(null, '', query ? `?${query}` : location.pathname);
		};

		const params = new URLSearchParams(location.search);
		search.value = params.get('q') ?? '';
		for (const c of chips) {
			if (params.get(c.dataset.key!)?.split(',').includes(c.dataset.value!)) {
				c.setAttribute('aria-pressed', 'true');
			}
			c.addEventListener('click', () => {
				c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
				apply();
			});
		}
		search.addEventListener('input', apply);
		if (location.search) apply();
	}
</script>
