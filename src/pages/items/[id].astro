---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MiniText from '../../components/MiniText.astro';
import { siteConfig } from '../../config/site.js';
import {
	CATEGORIES,
	STATUS_LABEL,
	flavour,
	items,
	regionLabel,
	type Item,
} from '../../utils/items.ts';
import { plainText } from '../../utils/minimessage.ts';

export function getStaticPaths() {
	return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: Item };
const name = plainText(item.name);
const category = CATEGORIES.find((c) => c.key === item.category)!.label;
const typeLine = item.type.join(' · ');
const description =
	flavour(item) ||
	`${typeLine || category} from ${regionLabel(item) === 'General' ? 'Void Tales' : regionLabel(item)}.`;

const ogImage = `/images/og/item-${item.id}.webp`;
const url = new URL(`/items/${item.id}`, siteConfig.url).toString();

const schema = {
	'@type': 'WebPage',
	'@id': `${url}#page`,
	name,
	description,
	image: new URL(ogImage, siteConfig.url).toString(),
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	breadcrumb: {
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Items', item: `${siteConfig.url}/items` },
			{ '@type': 'ListItem', position: 2, name, item: url },
		],
	},
};

const note = {
	live: null,
	experimental:
		'This item is on the test server. It can still change or be cut, and its stats stay hidden until it is in the game.',
	changedOnTest:
		'A new version of this item is being tested. What you see here is the one in the game right now.',
}[item.status];
---

<BaseLayout title={name} description={description} ogImage={ogImage} schema={schema}>
	<section class="section">
		<div class="shell shell-narrow">
			<a class="back-link" href="/items">← All items</a>
			<article class="item-detail">
				<div class="item-slot">
					<img
						src={item.icon}
						alt={item.iconMissing ? '' : name}
						width="128"
						height="128"
						decoding="async"
					/>
				</div>
				<div>
					{STATUS_LABEL[item.status] && <span class="item-badge">{STATUS_LABEL[item.status]}</span>}
					<h1 class="page-title item-title"><MiniText text={item.name} /></h1>
					<p class="item-card-meta">
						{[typeLine, regionLabel(item), category].filter(Boolean).join(' · ')}
					</p>
				</div>
			</article>

			<div class="mc-tooltip">
				<p class="mc-tooltip-name"><MiniText text={item.name} /></p>
				{
					item.lore.map((line) =>
						line === '' ? (
							<p class="mc-tooltip-gap" aria-hidden="true" />
						) : (
							<p>
								<MiniText text={line} />
							</p>
						)
					)
				}
			</div>

			{note && <p class="item-note">{note}</p>}
		</div>
	</section>
</BaseLayout>
