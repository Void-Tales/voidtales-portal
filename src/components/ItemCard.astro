---
import MiniText from './MiniText.astro';
import { STATUS_LABEL, regionShown, type Item } from '../utils/items.ts';

interface Props {
	item: Item;
}
const { item } = Astro.props;
---

<a class="item-card" href={`/items/${item.id}/`}>
	<img
		class="item-icon"
		src={item.icon}
		alt=""
		width="64"
		height="64"
		loading="lazy"
		decoding="async"
	/>
	<span class="item-card-name">
		<MiniText text={item.name} />
	</span>
	<span class="item-card-meta">
		{[item.type[0], regionShown(item)].filter(Boolean).join(' · ')}
	</span>
	{STATUS_LABEL[item.status] && <span class="item-badge">{STATUS_LABEL[item.status]}</span>}
</a>
