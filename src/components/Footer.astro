---
import { siteConfig } from '../config/site.js';
import { navigationLinks } from '../config/navigation.js';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
	<div class="shell footer-inner">
		<div class="footer-top">
			<a href="/" class="brand text-[0.95rem]">{siteConfig.name}</a>

			<nav class="ml-auto flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer navigation">
				{
					navigationLinks.map((link) => (
						<a
							href={link.href}
							target="_blank"
							rel="noopener"
							class="text-muted text-[0.85rem] transition-colors hover:text-accent"
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>

		<div class="footer-copyright text-muted text-[0.8rem]">
			<p>
				{/* One expression: Prettier collapses the whitespace between two of them. */}
				{`© ${year} ${siteConfig.footer}`}
			</p>

			{/* Eigene Zeile statt navigationLinks: die Liste speist auch den Header und
			    "Follow the Journey" und erzwingt oben target="_blank" — Pflichtseiten
			    der eigenen Domain gehören in denselben Tab. */}
			<nav class="mt-3 flex flex-wrap gap-x-5 gap-y-1" aria-label="Rechtliches">
				<a href="/impressum" class="transition-colors hover:text-accent">Impressum</a>
				<a href="/datenschutz" class="transition-colors hover:text-accent">Datenschutz</a>
			</nav>
		</div>
	</div>
</footer>
