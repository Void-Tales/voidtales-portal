---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site.js';
import { footerColumns, isExternal } from '../config/navigation.js';

const year = new Date().getFullYear();
// Same markup as the gallery footer (voidtales-gallery src/components/Footer.astro).
---

<footer class="site-footer">
	<div class="shell">
		<div class="footer-grid">
			<div class="footer-about">
				<a href="/" class="brand">
					<BrandMark />
					{siteConfig.name}
				</a>
				<p>{siteConfig.hero.subtitle}</p>
				<a href="/#join" class="footer-address">
					{siteConfig.mcServerHost}
				</a>
			</div>

			{footerColumns.map((col) => (
				<nav class="footer-col" aria-label={col.title}>
					<p class="footer-col-title">{col.title}</p>
					<ul>
						{col.links.map((link) => (
							<li>
								<a
									href={link.href}
									target={isExternal(link.href) ? '_blank' : undefined}
									rel={isExternal(link.href) ? 'noopener' : undefined}
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))}
		</div>

		<p class="footer-copyright">
			{/* One expression: Prettier collapses the whitespace between two of them. */}
			{`© ${year} ${siteConfig.footer}`}
		</p>
	</div>
</footer>
