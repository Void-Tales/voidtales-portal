---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site.js';
import { navigationLinks, isExternal, isCurrent } from '../config/navigation.js';

const path = Astro.url.pathname;

// ponytail: no CTA in the header. Eight nav links (Search is an icon button,
// not a ninth link) only fit centred from `lg` on; below that the burger menu
// takes over. If conversion ever needs a CTA, move "World Map" into the mobile
// menu first.
//
// Three-column grid, not flex: the nav sits on the true centre of the page
// even though brand and buttons differ in width. The gallery header is the
// same markup and must stay that way.
---

<header class="site-header">
	<div class="shell site-header-inner">
		<a href="/" class="brand" aria-label={`${siteConfig.name} home`}>
			{/* The V mark, identical to the gallery and the favicon: the network's recognition value. */}
			<BrandMark />
			{siteConfig.name}
		</a>

		{/* One link list, rendered twice (desktop bar + mobile dropdown). Never duplicate it. */}
		<nav class="header-nav" aria-label="Main navigation">
			{
				navigationLinks.map((link) => (
					<a
						href={link.href}
						target={isExternal(link.href) ? '_blank' : undefined}
						rel={isExternal(link.href) ? 'noopener' : undefined}
						aria-current={isCurrent(link.href, path) ? 'page' : undefined}
						class="nav-link"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="header-actions">
			<button
				type="button"
				id="menu-toggle"
				class="icon-btn lg:hidden"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					class="h-[1.05rem] w-[1.05rem]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>

			{/* Which icon shows is decided by CSS, so it is correct without JS. */}
			<button
				type="button"
				id="theme-toggle"
				class="icon-btn"
				aria-label="Toggle dark mode"
				title="Toggle dark mode"
			>
				<svg
					class="theme-icon theme-icon-moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
				</svg>
				<svg
					class="theme-icon theme-icon-sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path
						d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
					></path>
				</svg>
			</button>

			<a href="/search" class="icon-btn" aria-label="Search" title="Search">
				<svg
					class="h-[1.05rem] w-[1.05rem]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<path d="M21 21l-4.3-4.3"></path>
				</svg>
			</a>
		</div>
	</div>

	<div id="mobile-menu" hidden class="mobile-menu lg:hidden">
		<nav class="shell flex flex-col items-start gap-3 py-4" aria-label="Mobile navigation">
			{
				navigationLinks.map((link) => (
					<a
						href={link.href}
						target={isExternal(link.href) ? '_blank' : undefined}
						rel={isExternal(link.href) ? 'noopener' : undefined}
						aria-current={isCurrent(link.href, path) ? 'page' : undefined}
						class="nav-link"
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	const setMenu = (open: boolean) => {
		menu?.toggleAttribute('hidden', !open);
		menuToggle?.setAttribute('aria-expanded', String(open));
	};

	menuToggle?.addEventListener('click', () => setMenu(menu?.hasAttribute('hidden') ?? false));
	// Closed again by Escape, a click outside the header, or the desktop nav
	// taking over (tablet turned to landscape) - otherwise it reopens later
	// by itself and aria-expanded lies.
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
	document.addEventListener('click', (e) => {
		if (!(e.target as Element).closest('.site-header')) setMenu(false);
	});
	matchMedia('(width >= 64rem)').addEventListener('change', () => setMenu(false));

	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		} catch {
			// Private mode / storage disabled: the toggle still works for this page view.
		}
	});
</script>
