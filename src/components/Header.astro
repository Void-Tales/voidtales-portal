---
import { siteConfig } from '../config/site.js';
import { navigationLinks, isExternal } from '../config/navigation.js';

// ponytail: no CTA in the header. Six nav links (Search lives as an icon
// button next to the theme toggle instead, not a seventh nav-link) plus the
// mark plus the toggle already fill the desktop row; a seventh nav-link
// risks a two-line nav. If conversion ever needs one, move "World Map" into
// the mobile menu first.
---

<header class="site-header">
	<div class="shell site-header-inner">
		<a href="/" class="brand" aria-label={`${siteConfig.name} home`}>
			{/* The V mark, identical to the gallery: that is the network's recognition value. */}
			<svg class="h-7 w-7" viewBox="0 0 64 64" aria-hidden="true">
				<defs>
					<linearGradient id="vt-mark-bg" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#140f22"></stop>
						<stop offset="100%" stop-color="#0a0714"></stop>
					</linearGradient>
					<filter id="vt-mark-glow" x="-50%" y="-50%" width="200%" height="200%">
						<feGaussianBlur stdDeviation="2.2" result="blur"></feGaussianBlur>
						<feMerge>
							<feMergeNode in="blur"></feMergeNode>
							<feMergeNode in="SourceGraphic"></feMergeNode>
						</feMerge>
					</filter>
				</defs>
				<rect width="64" height="64" rx="14" fill="url(#vt-mark-bg)"></rect>
				<path
					d="M16 15 L32 46 L48 15"
					fill="none"
					stroke="#a78bfa"
					stroke-width="7"
					stroke-linecap="round"
					stroke-linejoin="round"
					filter="url(#vt-mark-glow)"></path>
			</svg>
			{siteConfig.name}
		</a>

		{/* One link list, rendered twice (desktop bar + mobile dropdown). Never duplicate it. */}
		<nav class="mx-auto hidden items-center gap-6 md:flex" aria-label="Main navigation">
			{
				navigationLinks.map((link) => (
					<a
						href={link.href}
						target={isExternal(link.href) ? '_blank' : undefined}
						rel={isExternal(link.href) ? 'noopener' : undefined}
						class="nav-link"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="ml-auto flex items-center gap-2">
			<button
				type="button"
				id="menu-toggle"
				class="icon-btn md:hidden"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					class="h-[1.05rem] w-[1.05rem]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>

			{/* Which icon shows is decided by CSS, so it is correct without JS. */}
			<button
				type="button"
				id="theme-toggle"
				class="icon-btn"
				aria-label="Toggle dark mode"
				title="Toggle dark mode"
			>
				<svg
					class="theme-icon theme-icon-moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
				</svg>
				<svg
					class="theme-icon theme-icon-sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path
						d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
					></path>
				</svg>
			</button>

			<a href="/search" class="icon-btn" aria-label="Search" title="Search">
				<svg
					class="h-[1.05rem] w-[1.05rem]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<path d="M21 21l-4.3-4.3"></path>
				</svg>
			</a>
		</div>
	</div>

	<div id="mobile-menu" hidden class="mobile-menu md:hidden">
		<nav class="shell flex flex-col gap-3 py-4" aria-label="Mobile navigation">
			{
				navigationLinks.map((link) => (
					<a
						href={link.href}
						target={isExternal(link.href) ? '_blank' : undefined}
						rel={isExternal(link.href) ? 'noopener' : undefined}
						class="nav-link"
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	menuToggle?.addEventListener('click', () => {
		const open = menu?.hasAttribute('hidden');
		if (open) menu?.removeAttribute('hidden');
		else menu?.setAttribute('hidden', '');
		menuToggle.setAttribute('aria-expanded', String(open));
	});

	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		} catch {
			// Private mode / storage disabled: the toggle still works for this page view.
		}
	});
</script>
