{
	"name": "void-tales-portal",
	"type": "module",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@11.11.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"media": "node scripts/media.mjs",
		"items": "node scripts/items.mjs",
		"prebuild": "pnpm run media && pnpm run items",
		"build": "astro check && astro build && node scripts/og.mjs && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"test": "node src/utils/motd.test.ts && node src/utils/minimessage.test.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.4.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@astrojs/markdown-satteri": "^0.4.5",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^0.14.1",
		"sharp": "^0.35.5"
	}
}
